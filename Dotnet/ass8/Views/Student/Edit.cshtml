@model ass8.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <div>
        <label>Marks</label>
        <input asp-for="Marks" />
    </div>

    <button type="submit">Update</button>
</form>
