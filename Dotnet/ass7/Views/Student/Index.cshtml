@model List<ass7.Models.Student>

<h2>Student List</h2>

<a asp-action="Seed" class="btn btn-primary">Insert Sample Data</a>

<table class="table table-bordered mt-3">
    <tr>
        <th>Name</th>
        <th>Department</th>
        <th>Marks</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Department</td>
            <td>@item.Marks</td>
        </tr>
    }
</table>
